# Required
RPC_URL=https://mainnet.base.org
PRIVATE_KEY=0x...
OPENROUTER_API_KEY=sk-or-...

# Optional
MORPHO_SUBGRAPH=https://gateway.thegraph.com/api/${MORPHO_SUBGRAPH_API_KEY}/subgraphs/id/71ZTy1veF9twER9CLMnPWeLQ7GZcwKsjmygejrgKirqs
MORPHO_SUBGRAPH_API_KEY=your-graph-api-key
MORPHO_BLUE_ADDRESS=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
SWAP_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
WETH_ADDRESS=0x4200000000000000000000000000000000000006

# Jev model (System One)
JEV_MODEL=typesafe/jev
JEV_TEMPERATURE=0.1
JEV_MAX_TOKENS=500

# Risk params
MAX_CONCURRENT=5
MIN_SEIZE_USD=500
MIN_PROFIT_FORECAST_USD=200
MIN_JEV_CONFIDENCE=0.55
MIN_JEV_SAFETY=0.60
MARGIN_BUFFER_USD=2000
GAS_COST_PCT_OF_PROFIT_MAX=0.40
ORACLE_DIVERGENCE_BPS=50

# Price facts (no fiction) — on-chain DEX exit venue + live oracle age
# Aerodrome factories on Base; quotes the collateral against these tokens
DEX_V2_FACTORY=0x420DD381b31aEf6683db6B902084cB0FFECe40Da
DEX_V3_FACTORY=0x5e7BB104d84c7CB9B682AaC2F3d509f5F406809A
DEX_QUOTE_TOKENS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913,0x4200000000000000000000000000000000000006
DEX_USE_V3=true
DEX_PRICE_TTL_SEC=300
ORACLE_AGE_TTL_SEC=60
# Max seized USD as fraction of one-sided pool depth a single exit can clear
EXIT_DEPTH_FRACTION=0.05

# At-risk watchlist — positions above the liquidation line but close enough to
# be worth a pre-computed Jev verdict for the moment they cross. The band is
# strictly (1.0, WATCH_HF_MAX]; the liquidatable scan already owns HF < 1.0.
# A borrower who is at risk in one market and liquidatable in another is two
# feed rows and two distinct Jev decisions.
WATCH_HF_MIN=0.98
WATCH_HF_MAX=1.30
# Only watch positions whose borrow is big enough to matter (at-risk dust = noise)
WATCH_MIN_BORROW_USD=1000
# "Play" slice of the at-risk queue — flag rows a solo bot could actually act on
# IF they cross: seize sized to fund, warm profit above a floor, oracle age
# verifiable (null/stale age = not playable). Classification only, never a gate.
WATCH_PLAYABLE_CAP_USD=250000
WATCH_MIN_PROFIT_USD=500
WATCH_ORACLE_MAX_AGE_SEC=300
# Collateral families with no real exit market stay out of the at-risk panel
# (they are already honestly blocked in the liquidatable feed). Override to ""
# to watch everything.
WATCH_COLLATERAL_DENYLIST=USR,RSS,RLP,wbCOIN,WXRWA1,stUSR,USDF,REIT,UBTC
# Scan cadence — drives how fast NEW liquidations AND watchline crossings are
# detected (Morpho indexer-bound). 10-15s is a good watch cadence.
SCAN_INTERVAL_MS=30000

# Telegram alerts (optional). Both must be set to enable; otherwise notifications
# are silently skipped. Everything is a one-liner. Events: an actionable
# opportunity was found, an execution settled or failed, and a periodic digest.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
# Digest times, comma-separated LOCAL hours (e.g. "9,17" = 9am + 5pm).
# Empty disables the periodic digest.
TELEGRAM_DIGEST_HOURS=9,17
