{
  "name": "defi-jev",
  "version": "0.1.0",
  "description": "AI-powered liquidation bot for Base lending protocols using TypeSafe's Jev System One model",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dry-run": "DRY_RUN=true npm run dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install"
  },
  "keywords": [
    "defi",
    "liquidation",
    "jev",
    "typesafe",
    "base",
    "aave",
    "ai"
  ],
  "author": "Faisal Siddiqi",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "pino": "^8.17.2",
    "prom-client": "^15.1.3",
    "telegraf": "^4.16.3",
    "viem": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
